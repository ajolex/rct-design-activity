# RCT Design Activity - Environment Variables
# Copy this file to .env and update the values for your deployment

# ===== FACILITATOR DASHBOARD =====
# Password for accessing the facilitator dashboard
ADMIN_PASSWORD=changeme

# ===== DEPLOYMENT =====
# App deployment URL (if hosting elsewhere)
RCT_FIELD_FLOW_URL=https://ajolex.github.io/rct_field_flow

# ===== DATA PATHS =====
# Optional: custom paths for data storage
# DATA_PATH=./data
# SAMPLE_DATA_PATH=./data/sample_data
# PROGRAM_CARDS_PATH=./data/program_cards

# ===== DEBUG MODE =====
# Set to true for debug output and additional logging
DEBUG_MODE=false

# ===== DEVELOPER INFO =====
# For watermark and footer display
DEVELOPER_NAME=Aubrey Jolex
DEVELOPER_EMAIL=aubreyjolex@gmail.com
